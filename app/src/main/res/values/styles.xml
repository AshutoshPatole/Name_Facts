<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Used by screens with a light (parchment) background so the system bar icons stay legible and window overdraw is avoided. -->
    <style name="AppTheme.LightBars" parent="AppTheme">
        <item name="android:windowBackground">@drawable/dobpaper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
